# Copy this file to an ignored .env in the consuming project.
# Never commit real credentials or send client plans/photos to an unapproved provider.

# RealmRouter OpenAI-compatible gateway for spatial reasoning and visual preview.
REALMROUTER_SPATIAL_API_KEY=
REALMROUTER_IMAGE_API_KEY=
REALMROUTER_BASE_URL=https://realmrouter.cn
REALMROUTER_SPATIAL_MODEL=gpt-5.6-sol
REALMROUTER_IMAGE_MODEL=gpt-image-2
REALMROUTER_SPATIAL_REASONING_EFFORT=high
REALMROUTER_IMAGE_SIZE=1536x1024
REALMROUTER_IMAGE_QUALITY=medium
REALMROUTER_TIMEOUT_MS=120000

# Kimi Code membership API for Three.js, Blender Python, scene configuration,
# and engineering tests. Kimi Code keys and Open Platform keys are not interchangeable.
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_ENGINEERING_MODEL=k3
KIMI_CODE_REASONING_EFFORT=high
KIMI_CODE_TIMEOUT_MS=120000

# Tencent Cloud Hunyuan3D Pro for furniture and decor assets.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
HUNYUAN3D_ENDPOINT=ai3d.tencentcloudapi.com
HUNYUAN3D_API_VERSION=2025-05-13
HUNYUAN3D_MODEL=3.1
HUNYUAN3D_SUBMIT_ACTION=SubmitHunyuanTo3DProJob
HUNYUAN3D_QUERY_ACTION=QueryHunyuanTo3DProJob

# Renderer-neutral pipeline defaults
SPATIAL_JSON_SCHEMA_VERSION=1.0
SCENE_UNITS=meters
SCENE_UP_AXIS=Y
ASSET_OUTPUT_FORMAT=glb
WEBXR_SESSION_MODE=immersive-vr
