# Copy this file to an ignored .env in the consuming project.
# Never commit real credentials or send client plans/photos to an unapproved provider.

# Spatial understanding and interior-design reasoning
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SPATIAL_MODEL=gpt-5.6
OPENAI_SPATIAL_REASONING_EFFORT=high

# Engineering agent for Three.js, Blender Python, scene configuration, and tests.
# The official Kimi platform identifies K3 as the current flagship. Confirm the exact
# API model slug exposed by your account before production deployment.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_ENGINEERING_MODEL=kimi-k3

# Tencent Cloud Hunyuan3D Pro for furniture and decor assets.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
HUNYUAN3D_ENDPOINT=ai3d.tencentcloudapi.com
HUNYUAN3D_API_VERSION=2025-05-13
HUNYUAN3D_MODEL=3.1
HUNYUAN3D_SUBMIT_ACTION=SubmitHunyuanTo3DProJob
HUNYUAN3D_QUERY_ACTION=QueryHunyuanTo3DProJob

# Renderer-neutral pipeline defaults
SPATIAL_JSON_SCHEMA_VERSION=1.0
SCENE_UNITS=meters
SCENE_UP_AXIS=Y
ASSET_OUTPUT_FORMAT=glb
WEBXR_SESSION_MODE=immersive-vr
