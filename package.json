{
  "name": "vr-3d-skill",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Production-gated interior design skill for traceable Spatial JSON, shell/hard/furnished GLB, WebXR, Blender, panorama, revision, and release workflows.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:syntax && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "doctor": "node scripts/doctor.mjs",
    "p2:fixtures": "node scripts/tests/fixtures/generate-p2-fixtures.mjs",
    "p2:acceptance": "node scripts/validation/run-p2-acceptance.mjs --output examples/p2-acceptance/automated-evidence.json",
    "p3:fixtures": "node scripts/tests/fixtures/generate-p3-fixtures.mjs",
    "p3:acceptance": "node scripts/validation/run-p3-acceptance.mjs --output examples/p3-acceptance/automated-evidence.json",
    "p4:fixtures": "node scripts/tests/fixtures/generate-p4-fixtures.mjs",
    "p4:acceptance": "node scripts/validation/run-p4-acceptance.mjs --output examples/p4-acceptance/automated-evidence.json",
    "p4:audit": "node scripts/validation/run-p4-performance-audit.mjs --output examples/p4-acceptance/performance-audit.json",
    "p5:fixtures": "node scripts/tests/fixtures/generate-p5-fixtures.mjs",
    "p5:acceptance": "node scripts/validation/run-p5-acceptance.mjs --output examples/p5-acceptance/automated-evidence.json",
    "p6:fixtures": "node scripts/tests/fixtures/generate-p6-fixtures.mjs",
    "p6:acceptance": "node scripts/validation/run-p6-acceptance.mjs --output examples/p6-acceptance/automated-evidence.json",
    "p7:fixtures": "node scripts/tests/fixtures/generate-p7-fixtures.mjs",
    "p7:acceptance": "node scripts/validation/run-p7-acceptance.mjs --output examples/p7-acceptance/automated-evidence.json",
    "p8:fixtures": "node scripts/tests/fixtures/generate-p8-fixtures.mjs",
    "p8:acceptance": "node scripts/validation/run-p8-acceptance.mjs --output examples/p8-acceptance/automated-evidence.json",
    "p9:fixtures": "node scripts/tests/fixtures/generate-p9-fixtures.mjs",
    "p9:acceptance": "node scripts/validation/run-p9-acceptance.mjs --output examples/p9-acceptance/automated-evidence.json",
    "p10:fixtures": "node scripts/tests/fixtures/generate-p10-fixtures.mjs",
    "p10:acceptance": "node scripts/validation/run-p10-acceptance.mjs --output examples/p10-acceptance/automated-evidence.json",
    "p10:code-acceptance": "node scripts/validation/run-p10-acceptance.mjs --code-only --output examples/p10-acceptance/code-evidence.json",
    "p10:security": "node scripts/security/audit-release.mjs --root . --output examples/p10-acceptance/security-audit.json",
    "p10:benchmark": "node scripts/performance/benchmark-core.mjs --output examples/p10-acceptance/core-benchmark.json",
    "job": "node scripts/orchestration/run-production-job.mjs",
    "migrate": "node scripts/migrations/migrate-project.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs --output release/sbom.cdx.json",
    "release:qualify": "node scripts/release/assemble-qualification-bundle.mjs",
    "release:encode-secret": "node scripts/release/encode-qualification-secret.mjs",
    "release:build": "node scripts/release/build-release.mjs --output dist",
    "release:verify": "node scripts/release/verify-release.mjs",
    "delivery:manifest": "node scripts/release/build-delivery-manifest.mjs",
    "project:accept": "node scripts/release/approve-real-project.mjs",
    "review:spatial": "node scripts/serve-viewer.mjs --directory assets/spatial-review --port 4174",
    "approval:key": "node scripts/approval/create-approval-key.mjs",
    "approve:spatial": "node scripts/approval/approve-spatial-json.mjs",
    "example": "node scripts/tests/build-bundled-example.mjs --output runs/example",
    "serve:example": "node scripts/serve-viewer.mjs --directory runs/example",
    "test": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "dxf-parser": "1.1.2",
    "sharp": "0.35.3",
    "three": "0.179.1"
  },
  "files": [
    ".env-example",
    "AI_VR室内设计系统方案设计思路.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SKILL.md",
    "需求文档.md",
    "agents/",
    "assets/",
    "config/",
    "docs/",
    "examples/",
    "references/",
    "release/",
    "schemas/",
    "scripts/"
  ]
}
