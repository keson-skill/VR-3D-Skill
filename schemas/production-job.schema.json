{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vr-3d-skill.local/schemas/production-job.schema.json",
  "title": "Production job definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "$ref": "#/$defs/jobId"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "kind": {
      "$ref": "#/$defs/stageId"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "base_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handler",
          "parameters"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stageId"
          },
          "handler": {
            "enum": [
              "prepare_interior_job",
              "validate_spatial",
              "await_spatial_approval",
              "build_viewable_scene",
              "verify_xr",
              "render_blender"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "stageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    }
  }
}
