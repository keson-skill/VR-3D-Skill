{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vr-3d-skill.local/schemas/spatial-approval-trust.schema.json",
  "title": "Spatial approval trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "keys"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "spatial_approval_trust" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "algorithm",
          "public_key_pem",
          "status",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "algorithm": { "const": "ed25519" },
          "public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----"
          },
          "status": { "enum": ["active", "revoked"] },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
