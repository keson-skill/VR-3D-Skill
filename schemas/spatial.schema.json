{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vr-3d-skill.local/schemas/spatial.schema.json",
  "title": "VR 3D Spatial Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project",
    "sources",
    "envelope",
    "rooms",
    "assumptions",
    "unresolved_questions",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "revision",
        "units",
        "up_axis",
        "forward_axis",
        "handedness",
        "origin"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string" },
        "revision": { "$ref": "#/$defs/nonEmptyString" },
        "units": { "const": "meters" },
        "up_axis": { "const": "Y" },
        "forward_axis": { "enum": ["-Z", "Z"] },
        "handedness": { "const": "right" },
        "origin": { "$ref": "#/$defs/vector3" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "requirements": {
      "type": "object"
    },
    "extraction": {
      "$ref": "#/$defs/extraction"
    },
    "source_conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["floor_elevation", "ceiling_height", "walls", "openings"],
      "properties": {
        "floor_elevation": { "type": "number" },
        "ceiling_height": { "type": "number", "exclusiveMinimum": 0 },
        "walls": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/wall" }
        },
        "openings": {
          "type": "array",
          "items": { "$ref": "#/$defs/opening" }
        },
        "architectural_elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/architecturalElement" }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    },
    "circulation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "minimum_clearance": { "type": "number", "exclusiveMinimum": 0 },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/circulationPath" }
        }
      }
    },
    "design_objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/designObject" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "host_id", "material_id"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "host_id": { "$ref": "#/$defs/stableId" },
          "room_id": { "$ref": "#/$defs/stableId" },
          "material_id": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/material" }
    },
    "lights": {
      "type": "array",
      "items": { "$ref": "#/$defs/light" }
    },
    "xr": {
      "$ref": "#/$defs/xr"
    },
    "render_profiles": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "approved_scope", "checks"],
      "properties": {
        "status": { "enum": ["pending", "blocked", "approved"] },
        "approved_scope": {
          "type": ["string", "null"],
          "enum": [null, "visualization_only", "construction_ready"]
        },
        "checks": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object" }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "approved_scope": {
                "enum": ["visualization_only", "construction_ready"]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vector2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "positiveVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false
    },
    "question": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["message"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "code": { "$ref": "#/$defs/nonEmptyString" },
            "message": { "$ref": "#/$defs/nonEmptyString" },
            "source_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/stableId" }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "uri": { "type": "string" },
        "revision": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "contains_personal_data": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "method", "confidence"],
      "properties": {
        "source_id": { "$ref": "#/$defs/stableId" },
        "source_entity_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "method": {
          "enum": [
            "measured",
            "parsed",
            "observed",
            "inferred",
            "generated",
            "user_edited"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tolerance_meters": {
          "type": "number",
          "minimum": 0
        },
        "model": { "type": "string" },
        "provider": { "type": "string" }
      }
    },
    "scaleAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pixel_start", "pixel_end", "distance_meters"],
      "properties": {
        "pixel_start": { "$ref": "#/$defs/vector2" },
        "pixel_end": { "$ref": "#/$defs/vector2" },
        "distance_meters": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_kind",
        "method",
        "scale",
        "topology_confidence",
        "coordinate_transform"
      ],
      "properties": {
        "source_kind": { "enum": ["dxf", "raster", "manual", "mixed"] },
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "scale": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "meters_per_source_unit"],
          "properties": {
            "status": { "enum": ["trusted", "estimated", "unknown"] },
            "meters_per_source_unit": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "anchor": { "$ref": "#/$defs/scaleAnchor" }
          }
        },
        "topology_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coordinate_transform": {
          "type": "object",
          "additionalProperties": true,
          "required": ["source_space", "target_space", "matrix_3x3"],
          "properties": {
            "source_space": { "$ref": "#/$defs/nonEmptyString" },
            "target_space": { "$ref": "#/$defs/nonEmptyString" },
            "matrix_3x3": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": { "type": "number" }
            }
          }
        },
        "source_conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "start",
        "end",
        "thickness",
        "height",
        "structural_role",
        "edit_policy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "start": { "$ref": "#/$defs/vector2" },
        "end": { "$ref": "#/$defs/vector2" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "structural_role": {
          "enum": ["load_bearing", "partition", "unknown"]
        },
        "edit_policy": {
          "enum": ["locked", "review_required", "editable"]
        },
        "material_id": { "$ref": "#/$defs/stableId" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "host_wall_id",
        "offset",
        "width",
        "height",
        "sill_height"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": [
            "hinged_door",
            "sliding_door",
            "open_passage",
            "window",
            "fixed_window"
          ]
        },
        "host_wall_id": { "$ref": "#/$defs/stableId" },
        "offset": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sill_height": { "type": "number", "minimum": 0 },
        "swing": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "boundary_wall_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "boundary_wall_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "area": { "type": "number", "exclusiveMinimum": 0 },
        "floor_elevation": { "type": "number" },
        "ceiling_elevation": { "type": "number" },
        "floor_material_id": { "$ref": "#/$defs/stableId" },
        "ceiling_material_id": { "$ref": "#/$defs/stableId" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "architecturalElement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "dimensions", "transform"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["column", "beam", "stair"] },
        "room_id": { "$ref": "#/$defs/stableId" },
        "material_id": { "$ref": "#/$defs/stableId" },
        "dimensions": { "$ref": "#/$defs/positiveVector3" },
        "step_count": { "type": "integer", "minimum": 2 },
        "transform": {
          "type": "object",
          "additionalProperties": true,
          "required": ["position"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation_euler_degrees": { "$ref": "#/$defs/vector3" }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "stair" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "step_count": { "type": "integer", "minimum": 2 }
            },
            "required": ["step_count"]
          }
        }
      ]
    },
    "circulationPath": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "polyline", "minimum_width"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "polyline": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/vector2" }
        },
        "minimum_width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "designObject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "room_id", "dimensions", "transform"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "room_id": { "$ref": "#/$defs/stableId" },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "material_id": { "$ref": "#/$defs/stableId" },
        "dimensions": { "$ref": "#/$defs/positiveVector3" },
        "transform": {
          "type": "object",
          "additionalProperties": true,
          "required": ["position"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation_euler_degrees": { "$ref": "#/$defs/vector3" },
            "scale": { "$ref": "#/$defs/vector3" }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "uri": { "type": "string" },
        "dimensions": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "position", "intensity"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/vector3" },
        "intensity": { "type": "number", "minimum": 0 }
      }
    },
    "xr": {
      "type": "object",
      "additionalProperties": true,
      "required": ["spawn"],
      "properties": {
        "spawn": { "$ref": "#/$defs/vector3" },
        "boundary_room_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    }
  }
}
